# ============================================================
# 缺集管家 v2.0 - 环境变量配置模板
#
# 使用方法：
#   1. 复制此文件为 .env
#   2. 把 MEDIA_DIR 改成你的 STRM 文件所在目录（宿主机绝对路径）
#   3. 保存后执行：docker compose up -d --build
# ============================================================

# -------- STRM 文件目录（必填） --------
# 你的 STRM 文件所在目录的宿主机绝对路径
# 例：/mnt/nas/video/strm 或 C:\Users\xxx\Videos\strm
# 容器内会被挂载到 /media
MEDIA_DIR=/你的strm目录

# -------- 第二个 STRM 目录（可选） --------
# MEDIA_DIR2=/你的第二个strm目录

# -------- 网页端口（可选）--------
# 默认 8899，如果端口冲突改这里
APP_PORT=8899

# -------- 数据目录（可选）--------
# 数据库、备份、配置文件的保存位置
# 默认 ./data（当前目录下的 data 文件夹）
DATA_DIR=./data

# -------- MoviePilot 地址（可选，也可在网页设置页填写）--------
# QUEJI_MP_URL=http://192.168.1.100:3000
# QUEJI_MP_TOKEN=你的MoviePilot_API_Token

# -------- TMDB API Key（可选，MoviePilot v3 无需填写）--------
# QUEJI_TMDB_KEY=你的TMDB_API_Key

# -------- 自动扫描（可选）--------
# QUEJI_AUTO_SCAN=false
# QUEJI_SCAN_INTERVAL=12
