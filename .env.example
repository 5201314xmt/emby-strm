# ============================================================
# 缺集管家 - 环境变量示例
# 使用方法：
#   1. 把这个文件复制一份，改名为 .env
#   2. 把 MEDIA_DIR 改成你的 strm 文件目录（服务器上的真实路径）
#   3. 执行 docker compose up -d 即可
# 不建 .env 也能用（会走 docker-compose.yml 里的默认值，但那需要手动改 yaml）
# ============================================================

# strm 文件目录（必改！改成你服务器上放 strm 文件的路径，如 /volume1/media/tv）
MEDIA_DIR=/你的strm目录

# 有第二个 strm 目录时，取消下面这行的注释并改路径
#MEDIA_DIR2=/你的第二个strm目录

# 数据保存目录（默认 ./data，配置/数据库都在这，备份它就行）
#DATA_DIR=./data

# 网页端口（默认 8899，想换端口就改这里，如 9000）
#APP_PORT=8899
